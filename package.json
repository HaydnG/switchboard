{
  "name": "switchboard",
  "version": "0.3.5",
  "private": true,
  "description": "A desktop app for browsing, searching, and managing CLI coding sessions",
  "author": "Doctly <support@doctly.ai>",
  "main": "main.js",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "start": "npm run bundle:codemirror && npm run build:logic && npm run build:renderer && electron .",
    "test": "npm run build:logic && node scripts/run-tests.js",
    "test:renderer": "vitest run",
    "build:logic": "esbuild src/renderer/lib/control-dialogs.ts --format=cjs --outfile=public/lib/control-dialogs.js --platform=neutral",
    "electron": "electron .",
    "smoke": "npm run bundle:codemirror && npm run build:logic && npm run build:renderer && node scripts/smoke-electron.js",
    "build:renderer": "vite build",
    "dev:renderer": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts vitest.config.ts",
    "format": "prettier --write src vite.config.ts vitest.config.ts package.json",
    "format:check": "prettier --check src vite.config.ts vitest.config.ts package.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:renderer && npm run build:renderer",
    "audit": "npm audit --audit-level=critical",
    "bundle:codemirror": "esbuild public/codemirror-setup.js --bundle --outfile=public/codemirror-bundle.js --format=iife --platform=browser --minify",
    "generate-icons": "node scripts/generate-icons.js && node scripts/generate-dmg-background.js",
    "build": "npm run bundle:codemirror && npm run build:logic && npm run build:renderer && electron-builder",
    "build:mac": "npm run bundle:codemirror && npm run build:logic && npm run build:renderer && electron-builder --mac && node scripts/postinstall.js && codesign --sign - --force --deep dist/mac-arm64/Switchboard.app 2>/dev/null; true",
    "build:mac:arm64": "electron-builder --mac --arm64 2>/dev/null; true",
    "build:win": "npm run bundle:codemirror && npm run build:logic && npm run build:renderer && electron-builder --win",
    "build:linux": "npm run bundle:codemirror && npm run build:logic && npm run build:renderer && electron-builder --linux",
    "release": "npm run bundle:codemirror && npm run build:logic && npm run build:renderer && electron-builder --publish always",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.0.0",
    "dompurify": "^3.4.12",
    "electron-log": "^5.3.0",
    "electron-updater": "^6.3.0",
    "marked": "^17.0.4",
    "morphdom": "^2.7.8",
    "node-pty": "^1.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.16",
    "@ddietr/codemirror-themes": "^1.5.2",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^0.1.62",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "codemirror": "^6.0.2",
    "electron": "^41.0.0",
    "electron-builder": "^26.15.3",
    "electron-reloader": "^1.2.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "png2icons": "^2.0.1",
    "prettier": "^3.9.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.2",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "ai.doctly.switchboard",
    "productName": "Switchboard",
    "files": [
      "*.js",
      "agent-runtimes/**/*",
      "workers/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/node-pty/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "HaydnG",
      "repo": "switchboard"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "icon": "build/icons",
      "category": "Development"
    },
    "pacman": {
      "packageName": "switchboard-doctly",
      "artifactName": "switchboard-doctly-${version}.${ext}",
      "depends": [
        "gtk3",
        "nss",
        "libnotify",
        "libxtst",
        "libxss",
        "xdg-utils",
        "libsecret"
      ]
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 170
        },
        {
          "x": 490,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
